---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.title.localeCompare(b.data.title),
);

const categories = Object.groupBy(notes, (note) => {
  const parts = note.id.split('/');
  return parts.length > 1 ? parts[0] : 'Uncategorized';
});
---

<BaseLayout
  title="Notes | Kanav Bhardwaj"
  description="Study notes and ideas by Kanav Bhardwaj."
>
  <Header />

  <section aria-label="Notes">
    <h1>Notes</h1>

    {Object.entries(categories).map(([category, categoryNotes]) => (
      <div>
        <h2>{category.replaceAll('-', ' ')}</h2>

        <ul>
          {categoryNotes?.map((note) => (
            <li>
              <a href={`/notes/${note.id}/`}>
                {note.data.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>

  <Footer />
</BaseLayout>

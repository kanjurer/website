---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<BaseLayout
  title="Kanav Bhardwaj"
  description="Personal website of Kanav Bhardwaj. Thoughts, explorations, and writing."
>
  <Header />

  <section class="intro">
    <div class="hero-copy">
      <p class="eyebrow">About</p>
      <h1>Hi, I'm Kanav.</h1>

      <p class="lead">
        I'm a software engineer interested in artificial intelligence,
        mathematics, physics, and understanding how things work.
      </p>
    </div>

    <div class="about-copy">
      <p>
        I enjoy exploring ideas, building things, and learning about subjects
        beyond my immediate field. This website is a place to document some of
        those explorations and share what I find interesting.
      </p>

      <p>
        Outside of work, I'm usually learning something new, reading,
        or figuring out what to build next.
      </p>
    </div>
  </section>

  <Footer />
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: start;
    gap: clamp(48px, 9vw, 120px);
    margin-bottom: 72px;
  }

  .hero-copy {
    max-width: 650px;
  }

  .eyebrow {
    margin: 0 0 18px;
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .intro h1 {
    margin: 0 0 22px;
    font-size: clamp(3rem, 6vw, 4.5rem);
  }

  .lead {
    max-width: 540px;
    margin: 0;
    color: #464c48;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .about-copy p {
    max-width: 660px;
    margin: 0 0 22px;
    color: #464c48;
    font-size: 1rem;
    line-height: 1.85;
  }

  @media (max-width: 600px) {
    .intro {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .hero-copy {
      max-width: none;
    }
  }
</style>

---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import PostListItem from "@/components/PostListItem.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title="Blog | Kanav Bhardwaj"
  description="Writing, thoughts, and explorations by Kanav Bhardwaj."
>
  <Header />

  <section>
    <h1>Writing</h1>

    <p class="intro">
      Thoughts, explorations, and things I've learned along the way.
    </p>

    <div class="posts">
      {posts.map((post) => (
        <PostListItem
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
          href={`/blog/${post.id}/`}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <p class="empty">Nothing here yet. Check back later.</p>
    )}
  </section>

  <Footer />
</BaseLayout>

<style>
  h1 {
    font-size: 2.5rem;
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }

  .intro {
    color: var(--color-muted);
    margin-bottom: 40px;
  }

  .posts {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .empty {
    color: var(--color-muted);
  }
</style>

---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import PostListItem from '@/components/PostListItem.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
---

<BaseLayout
  title="Blog | Kanav Bhardwaj"
  description="Writing, thoughts, and explorations by Kanav Bhardwaj."
>
  <Header compact />

  <section>
    <div class="posts">
      {posts.map((post) => (
        <PostListItem
          title={post.data.title}
          description={post.data.description}
          date={post.data.pubDate}
          href={`${import.meta.env.BASE_URL}/blog/${post.id}/`}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <p class="empty">
        I updated my website on November 2026, I have a few blogs in draft which
        I am working on. I will be putting one out in December. Stay tuned, as I
        write this while on vacation.
      </p>
    )}
  </section>

  <Footer />
</BaseLayout>

<style>
  h1 {
    font-size: 2.5rem;
    letter-spacing: -0.04em;
    margin: 0 0 12px;
  }

  .intro {
    color: var(--color-muted);
    margin-bottom: 40px;
  }

  .posts {
    display: flex;
    flex-direction: column;
  }

  .empty {
    color: var(--color-muted);
  }
</style>

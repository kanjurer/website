---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  pubDate: Date;
}

const { title, description, pubDate } = Astro.props;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`${title} | Kanav Bhardwaj`} description={description}>
  <Header />

  <article>
    <header class="article-header">
      <a href={`${import.meta.env.BASE_URL}/blog/`} class="back-link">
        ← All posts
      </a>

      <h1>{title}</h1>

      <time datetime={pubDate.toISOString()}>{formattedDate}</time>

      {description && <p class="description">{description}</p>}
    </header>

    <div class="article-content">
      <slot />
    </div>
  </article>

  <Footer />
</BaseLayout>

<style>
  .article-header {
    margin-bottom: 44px;
  }

  .back-link {
    display: inline-block;
    color: var(--color-muted);
    font-size: 0.8rem;
    margin-bottom: 32px;
  }

  h1 {
    max-width: 900px;
    font-size: clamp(2.8rem, 6vw, 4.1rem);
    margin: 0 0 14px;
  }

  time {
    color: var(--color-muted);
    font-size: 0.82rem;
  }

  .description {
    color: var(--color-muted);
    max-width: 760px;
    margin: 20px 0 0;
    font-size: 1.05rem;
    line-height: 1.75;
  }

  .article-content {
    max-width: 720px;
    color: #464c48;
    font-size: 1rem;
    line-height: 1.9;
  }

  .article-content :global(h2) {
    font-size: 2rem;
    letter-spacing: -0.035em;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .article-content :global(h3) {
    font-size: 1.55rem;
    letter-spacing: -0.025em;
    margin-top: 35px;
    margin-bottom: 12px;
  }

  .article-content :global(p) {
    margin-bottom: 24px;
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    padding-left: 26px;
    margin-bottom: 26px;
  }

  .article-content :global(pre) {
    overflow-x: auto;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: #f2f3f0;
    font-size: 0.85rem;
  }

  .article-content :global(blockquote) {
    border-left: 2px solid #9aab9e;
    margin: 30px 0;
    padding: 3px 0 3px 22px;
    color: var(--color-muted);
  }
</style>

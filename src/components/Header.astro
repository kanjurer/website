---
const links = [
  { label: 'About Me', href: `${import.meta.env.BASE_URL}about/` },
  { label: 'Blog', href: `${import.meta.env.BASE_URL}blog/` },
  { label: 'Notes', href: `${import.meta.env.BASE_URL}notes/` },
];

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<header class:list={['header', { compact }]}>
  <a href="/" class="brand">
    Kanav Bhardwaj
  </a>

  <nav aria-label="Main navigation">
    {links.map((link) => (
      <a
        href={link.href}
        aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
      >
        {link.label}
      </a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 17px;
    margin-bottom: 44px;
    border-bottom: 1px solid var(--color-border);
  }

  .header.compact {
    margin-bottom: 0;
  }

  .brand {
    font-size: 0.96rem;
    font-weight: 650;
    letter-spacing: -0.025em;
    white-space: nowrap;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  nav a {
    color: var(--color-muted);
    font-size: 0.84rem;
    font-weight: 500;
  }

  nav a[aria-current='page'] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }

  @media (max-width: 480px) {
    .header {
      margin-bottom: 32px;
      gap: 16px;
    }

    nav {
      gap: 16px;
    }
  }
</style>

---
interface Props {
  title: string;
  description?: string;
  date: Date;
  href: string;
}

const { title, description, date, href } = Astro.props;

const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<article class="post">
  <div class="post-heading">
    <a class="post-title" href={href}>{title}</a>
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </div>

  {description && <p>{description}</p>}
</article>

<style>
  .post-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }

  .post {
    padding: 20px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-title {
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .post-heading time {
    color: var(--color-muted);
    font-size: 0.76rem;
    white-space: nowrap;
  }

  .post p {
    color: var(--color-muted);
    max-width: 680px;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 5px 0 0;
  }

  @media (max-width: 600px) {
    .post-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 5px;
    }
  }
</style>

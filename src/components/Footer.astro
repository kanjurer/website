---
const socialLinks = [
  { label: "GitHub", href: "https://github.com/kanjurer" },
  { label: "LinkedIn", href: "https://linkedin.com/in/kanav-bhardwaj" },
];
---

<footer class="footer">
  <span>Kanav Bhardwaj</span>

  <nav aria-label="Social links">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label}
      </a>
    ))}
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 24px;
    margin-top: 72px;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.8rem;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a {
    color: var(--color-muted);
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 48px;
    }
  }
</style>

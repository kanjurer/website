---
const socialLinks = [
  { label: 'GitHub', href: 'https://github.com/kanjurer' },
  { label: 'LinkedIn', href: 'https://linkedin.com/in/kanav-bhardwaj' },
  { label: 'Mastodon', href: 'https://mastodon.social/@kanjurer' },
];
---

<footer class="footer">
  <span>Kanav Bhardwaj</span>

  <nav aria-label="Social links">
    {socialLinks.map((link) => (
      <a href={link.href} target="_blank" rel="noopener noreferrer">
        {link.label}
      </a>
    ))}
  </nav>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 22px;
    margin-top: 88px;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.76rem;
  }

  nav {
    display: flex;
    gap: 22px;
  }

  nav a {
    color: var(--color-muted);
    font-weight: 600;
  }

  nav a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 480px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 64px;
    }
  }
</style>
